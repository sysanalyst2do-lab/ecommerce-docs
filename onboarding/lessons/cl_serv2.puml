@startuml
skin rose

package "Frontend" {
  [Web UI] <<client>>
  [Mobile App] <<client>>
}

package "Backend" {
  [API Gateway] <<server>>
  [Order Service]
  [User Service]
  [Payment Service]
  [Shard Router] <<component>>
}

package "Database" {
  database "DB1" as DB1
  database "DB2" as DB2
  database "DB3" as DB3
}

[Web UI] --> [API Gateway]
[Mobile App] --> [API Gateway]

[API Gateway] --> [Order Service]
[API Gateway] --> [User Service]
[API Gateway] --> [Payment Service]

[Order Service] --> [Shard Router]
[User Service] --> [Shard Router]
[Payment Service] --> [Shard Router]

[Shard Router] --> DB1
[Shard Router] --> DB2
[Shard Router] --> DB3

@enduml