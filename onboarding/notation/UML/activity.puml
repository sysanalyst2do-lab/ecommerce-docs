@startuml
title Обработка вопросов с циклом уточнения

start

:'Есть ли вопрос?';
if (Есть вопрос?) then (нет)
  :'Нет вопроса'/
  stop
else (да)
  :'Сейчас перерыв\nна вопрос?';
  if (Перерыв на вопрос?) then (нет)
    :'Записать вопрос\nв чат';
    stop
  else (да)
    ' --- Цикл уточнения формулировки ---
    repeat
      :'Поднять руку\nи задать вопрос\nголосом';
      if (Вопрос сформулирован\nясно?) then (да)
        ' Выходим из цикла
      else (нет)
        :'Уточнить формулировку\nвопроса';
      endif
    repeat while (Вопрос всё ещё\nнеясен?) is (да) not (нет)

    ' Здесь вопрос уже ясен → идём в основную ветку
    if (Вопрос касается\nтемы лекции?) then (да)
      if (Ответ будет\nдальше в лекции?) then (да)
        :'Подвешиваем вопрос\nдо момента объяснения';
        stop
      else (нет)
        :'Группа может\nсама ответить?';
        if (Да) then (да)
          :'Задать вопрос\nгруппе';
          :'Группа отвечает';
          stop
        else (нет)
          :'Отвечает ведущий';
          stop
        endif
      endif
    else (нет)
      :'Подвешиваем вопрос,\nобсуждаем после лекции';
      stop
    endif
  endif
endif

@enduml