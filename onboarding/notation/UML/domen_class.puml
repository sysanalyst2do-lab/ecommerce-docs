@startuml
skin rose
title "Курс, роли и материалы (упрощённая)"

left to right direction

' Базовый класс для ролей, которые отвечают за курс
abstract class Организатор {
  +name : String
  +email : String
}

class Ведущий {
}

class "Ментор курса" as Mentor {
}

' Наследование ролей от Организатора
Организатор <|-- Ведущий
Организатор <|-- Mentor

class Участник {
  +name : String
  +email : String
}

class Курс {
  +title : String
}

class "Программа курса" as CourseProgram {
  +version : String
  +description : String
}

class Лекция {
  +topic : String
  +order : int
}

class Презентация {
  +title : String
  +fileUrl : String
}

class "Домашнее задание" as Homework {
  +title : String
  +dueDate : Date
}

' --- Связи и отношения ---

' Организаторы (ведущие, менторы и др.) и курс
Организатор "1..*" -- "1..*" Курс : отвечает за >

' Ведущие ведут курс
Курс "1" -- "1..*" Ведущий : ведёт >

' Менторы сопровождают участников (без прямой связи с курсом)
Mentor "1" -- "0..*" Участник : сопровождает >

' Программа курса принадлежит курсу и определяет лекции
Курс "1" *-- "1" CourseProgram : программа >
CourseProgram "1" *-- "1..*" Лекция : определяет >

' Курс агрегирует участников
Курс "1" o-- "1..*" Участник : записаны >

' Лекция использует презентацию
Лекция "1" o-- "0..1" Презентация : использует >

' Домашки принадлежат курсу и могут ссылаться на лекцию
Курс "1" o-- "0..*" Homework : включает >
Лекция "0..1" -- "0..*" Homework : основано на >

' Участники выполняют домашки
Участник "1" -- "0..*" Homework : выполняет >

@enduml