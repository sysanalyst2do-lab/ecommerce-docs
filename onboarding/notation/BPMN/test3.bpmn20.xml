      <outgoing>flow_materials_onboarding</outgoing>
    </userTask>
    <userTask id="task_send_onboarding" name="Разослать онбординг и ссылки на встречи">
      <incoming>flow_materials_onboarding</incoming>
      <outgoing>flow_onboarding_session1</outgoing>
    </userTask>
    <!-- 4 последовательные встречи -->
    <userTask id="session_1" name="Встреча 1">
      <incoming>flow_onboarding_session1</incoming>
      <outgoing>flow_session1_session2</outgoing>
    </userTask>
