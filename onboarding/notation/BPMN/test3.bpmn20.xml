        <flowNodeRef>session_2</flowNodeRef>
        <flowNodeRef>session_3</flowNodeRef>
        <flowNodeRef>session_4</flowNodeRef>
        <flowNodeRef>task_collect_feedback</flowNodeRef>
        <flowNodeRef>flow_start_program</flowNodeRef>
        <flowNodeRef>flow_program_materials</flowNodeRef>
        <flowNodeRef>flow_materials_onboarding</flowNodeRef>
        <flowNodeRef>flow_onboarding_session1</flowNodeRef>
        <flowNodeRef>flow_session1_session2</flowNodeRef>
        <flowNodeRef>flow_session2_session3</flowNodeRef>
        <flowNodeRef>flow_session3_session4</flowNodeRef>
        <flowNodeRef>flow_sessions_feedback</flowNodeRef>
        <flowNodeRef>flow_feedback_end</flowNodeRef>
      </lane>
    </laneSet>
