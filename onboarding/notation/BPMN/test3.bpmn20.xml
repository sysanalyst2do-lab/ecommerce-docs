      <outgoing>flow_session3_session4</outgoing>
    </userTask>
    <userTask id="session_4" name="Встреча 4">
      <incoming>flow_session3_session4</incoming>
      <outgoing>flow_sessions_feedback</outgoing>
    </userTask>
    <!-- Завершение и обратная связь -->
    <userTask id="task_collect_feedback" name="Собрать обратную связь по курсу">
      <incoming>flow_sessions_feedback</incoming>
      <outgoing>flow_feedback_end</outgoing>
    </userTask>
    <endEvent id="end" name="Курс завершён">
      <incoming>flow_feedback_end</incoming>
    </endEvent>
    <!-- Потоки -->
    <sequenceFlow id="flow_start_program" sourceRef="start" targetRef="task_prepare_program"/>
    <sequenceFlow id="flow_program_materials" sourceRef="task_prepare_program" targetRef="task_prepare_materials"/>
    <sequenceFlow id="flow_materials_onboarding" sourceRef="task_prepare_materials" targetRef="task_send_onboarding"/>
    <sequenceFlow id="flow_onboarding_session1" sourceRef="task_send_onboarding" targetRef="session_1"/>
    <sequenceFlow id="flow_session1_session2" sourceRef="session_1" targetRef="session_2"/>
    <sequenceFlow id="flow_session2_session3" sourceRef="session_2" targetRef="session_3"/>
    <sequenceFlow id="flow_session3_session4" sourceRef="session_3" targetRef="session_4"/>
    <sequenceFlow id="flow_sessions_feedback" sourceRef="session_4" targetRef="task_collect_feedback"/>
    <sequenceFlow id="flow_feedback_end" sourceRef="task_collect_feedback" targetRef="end"/>
    <extensionElements>
      <flowable:executionListener class="Тест "/>
    </extensionElements>
    <laneSet id="sid-6e7f40c5-5816-4268-a755-9396546def51">
